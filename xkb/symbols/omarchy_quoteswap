// UK layout with only the two shifted keys exchanged.
// Third and fourth level symbols stay identical to gb(basic).
default partial alphanumeric_keys
xkb_symbols "basic" {
    include "gb(basic)"
    name[Group1] = "English (UK, swapped @ and quotes)";
    key <AE02> { [ 2, at, twosuperior, oneeighth ] };
    key <AC11> { [ apostrophe, quotedbl, dead_circumflex, dead_caron ] };
};
